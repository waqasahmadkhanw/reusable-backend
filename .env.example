# ================= REUSABLE MERN BACKEND =================
PORT=5000
NODE_ENV=development
TRUST_PROXY=false
GLOBAL_RATE_LIMIT=300
AUTH_RATE_LIMIT=10
APP_NAME=My App
MONGODB_URI=mongodb://localhost:27017/my_app
MONGODB_DB_NAME=my_app

ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret
REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Authentication cookie policy
# For cross-site frontend/API deployments use SameSite=None and HTTPS.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=

WEB_URL=http://localhost:3000
ADMIN_PANEL=http://localhost:4000
LOCAL_WEB=http://localhost:3000
LOCAL_ADMIN_PANEL=http://localhost:4000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
EMAIL_USER=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESET_PASSWORD_URL=http://localhost:3000/reset-password?token={token}

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/payment-success
STRIPE_CANCEL_URL=http://localhost:3000/payment-cancel

# ---------- EasyPaisa ----------
EASYPAISA_BASE_URL=https://sandbox.easypaisa.com.pk
EASYPAISA_MERCHANT_ACCOUNT=
EASYPAISA_MERCHANT_PASSWORD=
EASYPAISA_STORE_ID=
EASYPAISA_STORE_PASSWORD=
EASYPAISA_PAYMENT_API=/easypaisa/generate-hmac-token-gateway
EASYPAISA_STATUS_API=/easypaisa/get-payment-status-gateway
EASYPAISA_REFUND_API=/easypaisa/refund-gateway
EASYPAISA_INITIALS=VI
EASYPAISA_INLINE_APPROVE=false

# ---------- JazzCash ----------
JAZZCASH_BASE_URL=https://sandbox.jazzcash.com.pk
JAZZCASH_MERCHANT_ID=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_IS_LIVE=false
JAZZCASH_SUCCESS_URL=
JAZZCASH_CANCEL_URL=
JAZZCASH_SUCCESS_REDIRECT=
JAZZCASH_CANCEL_REDIRECT=

# ---------- Initial admin ----------
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_before_running_seed

# Cookie SameSite should normally be "none" only when frontend/API are cross-site.

# Phase 06 upload security
MAX_UPLOAD_SIZE=10485760
MAX_UPLOAD_FILES=10
MAX_UPLOAD_FIELDS=20
MAX_UPLOAD_PARTS=30
TEMP_FILE_MAX_AGE_MS=3600000
TEMP_CLEANUP_INTERVAL_MS=900000
UPLOAD_TEMP_DIR=public/temp

# MongoDB connection tuning
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2
MONGODB_MAX_IDLE_TIME_MS=60000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=45000
MONGODB_HEARTBEAT_MS=10000

# Graceful shutdown
SHUTDOWN_TIMEOUT_MS=10000

# Distributed API rate limiting (MongoDB-backed)
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT=10
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT=20

# Readiness probe database ping timeout
READINESS_DB_TIMEOUT_MS=2000
PAYMENT_GATEWAY_TIMEOUT_MS=10000
GATEWAY_CALLBACK_RATE_LIMIT=60

# Production observability
METRICS_ENABLED=false
# Required when METRICS_ENABLED=true; use a random secret of at least 32 characters.
METRICS_TOKEN=
